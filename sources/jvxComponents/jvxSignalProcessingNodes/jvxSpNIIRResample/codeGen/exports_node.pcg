SECTION PROPERTIES
{
	OUTPUTFILE_NAME = "genIIRResample_node";

	SECTION config
	{
		GENERATE_ENTRIES_CONFIG_FILE = "yes";
		GENERATE_ENTRIES_LINK_OBJECTS = "yes";       // Defaults to "no" if not present
		ALLOWED_STATE_MASK = {"JVX_STATE_ACTIVE", "JVX_STATE_PREPARED", "JVX_STATE_PROCESSING"};
		CALLBACKS = {"set_mode", "set_config", "set_preset"};		

		SECTION fixed_rate_location_mode
		{
			TYPE = "JVX_DATAFORMAT_SELECTION_LIST";
			SELECTION_LIST_NAMES = {"INPUT", "OUTPUT"};
			SELECTION_LIST_SELECTED = {"no", "yes"};
			SELECTION_LIST_EXCLUSIVE = {"no", "no"};
			SELECTION_TRANSLATOR_TYPE = "jvxRateLocationMode";
			SELECTION_LIST_TRANSLATORS = {"JVX_FIXED_RATE_LOCATION_INPUT", "JVX_FIXED_RATE_LOCATION_OUTPUT"};
			SELECTION_TRANSLATOR_ENUM_CLASS = "yes";
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_AND_WRITE_CONTENT";
			ONLY_SELECTION_TO_CONFIG = "yes";
			CONTENT_DECODER_TYPE = "JVX_PROPERTY_DECODER_SINGLE_SELECTION";
			CALLBACK_SET_POSTHOOK = "set_mode";
		};

		SECTION filter_technology
		{
			TYPE = "JVX_DATAFORMAT_SELECTION_LIST";
			SELECTION_LIST_NAMES = {"BUTTERWORTH", "ELLIPTIC", "CHEBYSHEV1", "CHEBYSHEV2"};
			SELECTION_LIST_SELECTED = {"yes", "no", "no", "no"};
			SELECTION_LIST_EXCLUSIVE = {"no", "no", "no", "no"};
			SELECTION_TRANSLATOR_TYPE = "jvxIIRResamplerFilterTechnology";
			SELECTION_LIST_TRANSLATORS = {"JVX_IIR_RESAMPLER_FILTER_BUTTERWORTH", "JVX_IIR_RESAMPLER_FILTER_ELLIPTIC", "JVX_IIR_RESAMPLER_FILTER_CHEBYSHEV1", "JVX_IIR_RESAMPLER_FILTER_CHEBYSHEV2"};
			SELECTION_TRANSLATOR_ENUM_CLASS = "yes";
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_AND_WRITE_CONTENT";
			ONLY_SELECTION_TO_CONFIG = "yes";
			CONTENT_DECODER_TYPE = "JVX_PROPERTY_DECODER_SINGLE_SELECTION";
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION force_samplerate
		{
			TYPE = "JVX_DATAFORMAT_SIZE";
			INIT_SET = -1;		
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION filter_order
		{
			TYPE = "JVX_DATAFORMAT_SIZE";
			INIT_SET = 4;
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION filter_ripple_db
		{
			TYPE = "JVX_DATAFORMAT_DATA";
			INIT_SET = 0.05;
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION filter_stopdb_roll
		{
			TYPE = "JVX_DATAFORMAT_DATA";
			INIT_SET = 60;
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION filter_cutoff_scale
		{
			TYPE = "JVX_DATAFORMAT_DATA";
			INIT_SET = 0.9;
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION filter_freqwidth
		{
			TYPE = "JVX_DATAFORMAT_DATA";
			INIT_SET = 0.0;
			CALLBACK_SET_POSTHOOK = "set_config";
		};

		SECTION filter_presets
		{
			TYPE = "JVX_DATAFORMAT_SELECTION_LIST";
			SELECTION_LIST_NAMES = {				
				"BUTTER_LOW_QUALITY", "BUTTER_MEDIUM_QUALITY", "BUTTER_HIGH_QUALITY",
				"ELLIPTIC_LOW_QUALITY", "ELLIPTIC_MEDIUM_QUALITY", "ELLIPTIC_HIGH_QUALITY",
				"CHEBYI_LOW_QUALITY", "CHEBYI_MEDIUM_QUALITY", "CHEBYI_HIGH_QUALITY",
				"CHEBYII_LOW_QUALITY", "CHEBYII_MEDIUM_QUALITY", "CHEBYII_HIGH_QUALITY"
			};
			SELECTION_LIST_SELECTED = {
				"no", "no", "no",
				"no", "yes", "no",
				"no", "no", "no",
				"no", "no", "no"
				};
			SELECTION_LIST_EXCLUSIVE = {
				"no", "no", "no",
				"no", "no", "no",
				"no", "no", "no",
				"no", "no", "no"
				};	
			SELECTION_TRANSLATOR_TYPE = "jvxIIRResamplerFilterPresets";
			SELECTION_LIST_TRANSLATORS = {
				"JVX_IIR_RESAMPLER_PRESET_BUTTER_LOW_QUALITY", "JVX_IIR_RESAMPLER_PRESET_BUTTER_MEDIUM_QUALITY", 
				"JVX_IIR_RESAMPLER_PRESET_BUTTER_HIGH_QUALITY", "JVX_IIR_RESAMPLER_PRESET_ELLIPTIC_LOW_QUALITY", 
				"JVX_IIR_RESAMPLER_PRESET_ELLIPTIC_MEDIUM_QUALITY", "JVX_IIR_RESAMPLER_PRESET_ELLIPTIC_HIGH_QUALITY",
				"JVX_IIR_RESAMPLER_PRESET_CHEBYI_LOW_QUALITY", "JVX_IIR_RESAMPLER_PRESET_CHEBYI_MEDIUM_QUALITY", 
				"JVX_IIR_RESAMPLER_PRESET_CHEBYI_HIGH_QUALITY", "JVX_IIR_RESAMPLER_PRESET_CHEBYII_LOW_QUALITY", 
				"JVX_IIR_RESAMPLER_PRESET_CHEBYII_MEDIUM_QUALITY", "JVX_IIR_RESAMPLER_PRESET_CHEBYII_HIGH_QUALITY"
				};
			SELECTION_TRANSLATOR_ENUM_CLASS = "yes";
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_AND_WRITE_CONTENT";
			CONTENT_DECODER_TYPE = "JVX_PROPERTY_DECODER_SINGLE_SELECTION";
			CALLBACK_SET_POSTHOOK = "set_preset";
		};
	};

	SECTION resampling
	{
		GENERATE_ENTRIES_CONFIG_FILE = "no";        // Defaults to "no" if not present
		GENERATE_ENTRIES_LINK_OBJECTS = "yes";       // Defaults to "no" if not present
		ALLOWED_STATE_MASK = {"JVX_STATE_SELECTED", "JVX_STATE_ACTIVE", "JVX_STATE_PREPARED", "JVX_STATE_PROCESSING"};

		SECTION factor_num
		{
			TYPE = "JVX_DATAFORMAT_SIZE";
			INIT_SET = 1;
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_ONLY";
			ASSOCIATE_EXTERNAL = "yes";
		};
		SECTION factor_den
		{
			TYPE = "JVX_DATAFORMAT_SIZE";
			INIT_SET = 1;
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_ONLY";
			ASSOCIATE_EXTERNAL = "yes";
		};
	};

	SECTION design
	{
		GENERATE_ENTRIES_CONFIG_FILE = "no";        // Defaults to "no" if not present
		GENERATE_ENTRIES_LINK_OBJECTS = "yes";       // Defaults to "no" if not present
		ALLOWED_STATE_MASK = {"JVX_STATE_ACTIVE", "JVX_STATE_PREPARED", "JVX_STATE_PROCESSING"};
		
		SECTION gain
		{
			TYPE = "JVX_DATAFORMAT_STRING";
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_ONLY";
		};

		SECTION sos
		{
			TYPE = "JVX_DATAFORMAT_STRING";
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_ONLY";
		};

		SECTION fs
		{
			TYPE = "JVX_DATAFORMAT_STRING";
			READ_WRITE_ACCESS = "JVX_PROPERTY_ACCESS_READ_ONLY";
		};
	};
};
